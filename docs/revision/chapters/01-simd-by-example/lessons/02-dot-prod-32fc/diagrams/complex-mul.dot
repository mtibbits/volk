digraph cmul {
  rankdir=LR;
  node [shape=box, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  arcr [label="ar × cr"]; aici [label="ai × ci"]; arci [label="ar × ci"]; aicr [label="ai × cr"];
  re [label="real = ar·cr − ai·ci", id="sse3-addsub"];
  im [label="imag = ar·ci + ai·cr"];
  arcr -> re; aici -> re [label="−"];
  arci -> im; aicr -> im [label="+"];
}
